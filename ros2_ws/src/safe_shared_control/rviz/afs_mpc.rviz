Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Map
      Name: OccupancyGrid
      Enabled: true
      Color Scheme: map
      Topic:
        Value: /afs/ogm
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: SafeRegion
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /afs/safe_region
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.05
      Color: 255; 0; 0
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: VehicleAndObstacles
      Enabled: true
      Topic:
        Value: /afs/markers
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: IntentPath
      Enabled: true
      Color: 255; 170; 0
      Line Style: Lines
      Topic:
        Value: /afs/intent_path
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Enabled: true
      Color: 0; 255; 0
      Line Style: Lines
      Topic:
        Value: /afs/planned_path
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: FeasiblePolytopes
      Enabled: true
      Topic:
        Value: /afs/polytopes
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: StatusIndicator
      Enabled: true
      Topic:
        Value: /afs/status
        Reliability Policy: Reliable
        History Policy: Keep Last
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 40
      Target Frame: odom
      X: 9.0
      Y: 6.0
